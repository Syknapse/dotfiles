#!/usr/bin/env bash
# Pre-push gate — refuses to push if the repo wouldn't install cleanly.
# Runs the fast lint (lint.sh) and the sandboxed fresh-install simulation
# (test/sandbox-install.sh). The slow, network-bound Brewfile drift check is
# left to scheduled CI.
#
# Enable once:        git config core.hooksPath .githooks
# Bypass in a pinch:  git push --no-verify
set -e

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

# Run a check quietly, but replay its output if it fails so we know why it failed.
run_step() {
  local label="$1"; shift
  echo "▶ pre-push: $label"
  local out
  if ! out="$("$@" 2>&1)"; then
    printf '%s\n' "$out"
    echo "❌ pre-push: $label failed — push aborted (bypass once with: git push --no-verify)"
    exit 1
  fi
}

run_step "lint (lint.sh)" ./lint.sh
run_step "fresh-install simulation (test/sandbox-install.sh)" ./test/sandbox-install.sh

echo "✅ pre-push checks passed"
