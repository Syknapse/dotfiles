#!/usr/bin/env zsh
# Private environment variables — API keys, tokens, etc.
#
# HOW TO USE:
#   1. Copy this file: cp secrets.example secrets
#   2. Fill in your values
#   3. The install script will symlink it to ~/.secrets
#   4. zshrc will source it automatically
#
# NEVER commit the 'secrets' file — it is gitignored.

# export OPENAI_API_KEY=""
# export ANTHROPIC_API_KEY=""
# export GITHUB_TOKEN=""
